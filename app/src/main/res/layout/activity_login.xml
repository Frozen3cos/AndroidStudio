<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="32dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="32dp" />

    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/avatar1"
        android:contentDescription="@string/select_avatar"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tap_to_select_avatar"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="@string/hint_username"
        android:background="@drawable/custom_background"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="16sp"
        android:inputType="text"
        android:maxLines="1"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="@string/hint_password"
        android:background="@drawable/custom_background"
        android:paddingStart="16dp"
        android:paddingEnd="48dp"
        android:textSize="16sp"
        android:inputType="textPassword"
        android:maxLines="1"
        android:drawableEnd="@drawable/ic_visibility_off"
        android:drawablePadding="8dp"
        android:layout_marginBottom="16dp" />

    <CheckBox
        android:id="@+id/cbRemember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/remember_password"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_gravity="start"
        android:layout_marginBottom="8dp" />

    <!-- C4: 错误提示，初始隐藏 -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FF4444"
        android:textSize="13sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <com.example.myapplication.CustomButton
        android:id="@+id/btnLogin"
        android:layout_width="200dp"
        android:layout_height="52dp"
        app:buttonText="@string/btn_login"
        app:buttonColor="#4CAF50" />

    <!-- 新增：去注册入口 -->
    <TextView
        android:id="@+id/tvGoRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/go_register"
        android:textSize="14sp"
        android:textColor="#2196F3"
        android:padding="12dp"
        android:layout_marginTop="16dp" />

</LinearLayout>