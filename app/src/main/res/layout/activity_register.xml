<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_title"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.05"
            android:layout_marginBottom="24dp" />

        <!-- 卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp"
                android:gravity="center_horizontal">

                <!-- 头像 -->
                <ImageView
                    android:id="@+id/ivRegAvatar"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/avatar1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/select_avatar"
                    android:background="@drawable/bg_avatar_ring"
                    android:padding="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tap_to_select_avatar"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="20dp" />

                <!-- 用户名 -->
                <EditText
                    android:id="@+id/etRegUsername"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/hint_reg_username"
                    android:background="#F5F5F5"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:layout_marginBottom="12dp" />

                <!-- 密码 -->
                <EditText
                    android:id="@+id/etRegPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/hint_reg_password"
                    android:background="#F5F5F5"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:layout_marginBottom="6dp" />

                <!-- 密码强度指示条 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <View
                        android:id="@+id/vStrength1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#E0E0E0"
                        android:layout_marginEnd="2dp" />
                    <View
                        android:id="@+id/vStrength2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#E0E0E0"
                        android:layout_marginEnd="2dp" />
                    <View
                        android:id="@+id/vStrength3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#E0E0E0" />
                </LinearLayout>

                <!-- 强度提示文字 -->
                <TextView
                    android:id="@+id/tvStrengthLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pwd_strength_weak"
                    android:textSize="12sp"
                    android:textColor="#BBBBBB"
                    android:layout_marginBottom="12dp" />

                <!-- 确认密码 -->
                <EditText
                    android:id="@+id/etRegConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/hint_reg_confirm"
                    android:background="#F5F5F5"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:layout_marginBottom="12dp" />

                <!-- 手机号 -->
                <EditText
                    android:id="@+id/etRegPhone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/hint_reg_phone"
                    android:background="#F5F5F5"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp"
                    android:inputType="phone"
                    android:maxLength="11"
                    android:maxLines="1"
                    android:layout_marginBottom="12dp" />

                <!-- 邮箱 -->
                <EditText
                    android:id="@+id/etRegEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/hint_reg_email"
                    android:background="#F5F5F5"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:layout_marginBottom="8dp" />

                <!-- 同意协议 -->
                <CheckBox
                    android:id="@+id/cbAgree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agree_terms"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_gravity="start"
                    android:buttonTint="#4CAF50"
                    android:layout_marginBottom="8dp" />

                <!-- 错误提示 -->
                <TextView
                    android:id="@+id/tvRegError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FF4444"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <!-- 注册按钮 -->
                <com.example.myapplication.CustomButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:buttonText="@string/btn_register"
                    app:buttonColor="#4CAF50" />

                <!-- 已有账号？去登录 -->
                <TextView
                    android:id="@+id/tvGoLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/go_login"
                    android:textSize="13sp"
                    android:textColor="#2196F3"
                    android:padding="12dp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>