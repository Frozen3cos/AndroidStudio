<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#4CAF50">

        <ImageView
            android:id="@+id/ivDetailAvatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/avatar1"
            android:contentDescription="@string/user_avatar" />

        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="好友昵称"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvDetailSignature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="这个人很懒，什么都没留下"
            android:textSize="14sp"
            android:textColor="#E0E0E0"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_margin="16dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="12dp">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/label_gender"
                android:textSize="16sp"
                android:textColor="#888888" />
            <TextView
                android:id="@+id/tvDetailGender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="男"
                android:textSize="16sp"
                android:textColor="#333333" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#EEEEEE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="12dp">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/label_phone"
                android:textSize="16sp"
                android:textColor="#888888" />
            <TextView
                android:id="@+id/tvDetailPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="13800000000"
                android:textSize="16sp"
                android:textColor="#333333" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#EEEEEE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="12dp">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/label_email"
                android:textSize="16sp"
                android:textColor="#888888" />
            <TextView
                android:id="@+id/tvDetailEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="example@mail.com"
                android:textSize="16sp"
                android:textColor="#333333" />
        </LinearLayout>
    </LinearLayout>

    <com.example.myapplication.CustomButton
        android:id="@+id/btnSendMsg"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:layout_marginBottom="0dp"
        app:buttonText="@string/btn_send_msg"
        app:buttonColor="#4CAF50" />

    <com.example.myapplication.CustomButton
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        app:buttonText="@string/btn_back"
        app:buttonColor="#2196F3" />

</LinearLayout>